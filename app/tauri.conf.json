{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiiny Control Panel",
  "version": "1.4.3",
  "identifier": "ai.tiiny.control-panel",
  "build": {
    "beforeDevCommand": "",
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Tiiny Control Panel",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": ["binaries/tiiny-panel"]
  }
}
